#!/usr/bin/env python3
"""hermes-chrome-agent: keep a real Google Chrome on an invisible virtual display, drivable over CDP.

Subcommands:
  run        supervisor (what the LaunchAgent runs): starts hermes-vdisplay + Chrome, keeps every Chrome
             window on the virtual display, restarts whichever child dies, and posts a macOS notification
             when a page asks for a passkey (WebAuthn get/create) so a human knows to tap Touch ID.
  status     print supervisor state, displays and Chrome windows
  show       move the agent's windows onto the main display and pause re-homing (to look / click)
  hide       resume re-homing (windows go back to the virtual display within ~1s)
  install    build hermes-vdisplay and write + load the LaunchAgent
  uninstall  unload and remove the LaunchAgent

Stdlib only (runs under /usr/bin/python3). Configuration via environment:
  HERMES_HOME                    default ~/.hermes
  HERMES_CHROME_AGENT_PORT       CDP port clients use (default 9333, loopback only; served by the focus-filter proxy)
  HERMES_CHROME_AGENT_CHROME_PORT  Chrome's own CDP port behind the proxy (default PORT+1 = 9334, loopback only)
  HERMES_CHROME_AGENT_FOCUS_FILTER=0     no proxy: Chrome listens on PORT directly and raising calls go through
  HERMES_CHROME_AGENT_PROFILE    Chrome --user-data-dir (default $HERMES_HOME/chrome-agent)
  HERMES_CHROME_AGENT_TOOLS      dir holding the hermes-vdisplay binary (default $HERMES_HOME/chrome-agent-tools)
  HERMES_CHROME_AGENT_CHROME     Chrome binary (default /Applications/Google Chrome.app/Contents/MacOS/Google Chrome)
  HERMES_CHROME_AGENT_LABEL      LaunchAgent label (default com.hermes.chrome-agent)
  HERMES_CHROME_AGENT_SHOW_ON_PASSKEY=1  bring the passkey-requesting window to the main display until it settles
  HERMES_CHROME_AGENT_FOCUS_GUARD=0      let the agent Chrome take keyboard focus whenever a CDP client asks

Focus filter: Chrome listens on CHROME_PORT and the supervisor serves PORT as a transparent CDP proxy
(HTTP /json/* and every websocket). Unless the show flag is set (`show`, browser_focus), it rewrites the calls
that make macOS raise Chrome: Target.createTarget gets background:true (and loses focus:true),
Target.activateTarget and Page.bringToFront are answered {} without reaching Chrome, GET /json/activate/<id>
is answered "Target activated", and PUT /json/new?url becomes a background Target.createTarget. Each rewrite is
logged as `focus-filter: <method> from pid N (command) rewritten`. The supervisor's own CDP connection (passkey
reveal) talks to CHROME_PORT directly.

Focus guard (backstop): a CDP client that opens a foreground tab (Target.createTarget without background=true),
activates a target or calls Page.bringToFront makes macOS hand the agent Chrome keyboard focus, even while its
windows sit on the virtual display. The supervisor polls the frontmost app every 0.25s and gives focus back
to the app the user had in front, unless the activation was asked for: `show` ran in the last 10s
(browser_focus, the status-bar toggle), a passkey notification was clicked, or the user just clicked or
pressed a modifier (Dock, window click, Cmd-Tab). Each hand-back is logged as `focus-guard: ...`.

Passkey notifications come from "Hermes Touch ID.app" (notifier.swift, built by `install`): clicking the
notification or its Show button moves the window holding the asking tab onto the main display, selects that
tab and brings Chrome to the front until the request settles. If notifications are not allowed for the app,
it reveals the asking window on the main display at once and the app shows a floating alert with a Show button
instead. If the app is missing, the window is revealed and Chrome brought forward right away. There is no
osascript fallback: an osascript notification belongs to Script Editor and cannot bring Chrome forward.
"""
import base64
import json
import os
import re
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
HERMES_HOME = os.environ.get("HERMES_HOME") or os.path.join(HOME, ".hermes")
PORT = int(os.environ.get("HERMES_CHROME_AGENT_PORT") or 9333)
# Focus filter: Chrome itself listens on CHROME_PORT and the supervisor proxies PORT -> CHROME_PORT, rewriting
# CDP calls that would raise Chrome. HERMES_CHROME_AGENT_FOCUS_FILTER=0 puts Chrome straight on PORT again.
FOCUS_FILTER = os.environ.get("HERMES_CHROME_AGENT_FOCUS_FILTER", "1") not in ("", "0", "false")
CHROME_PORT = (int(os.environ.get("HERMES_CHROME_AGENT_CHROME_PORT") or PORT + 1)) if FOCUS_FILTER else PORT
PROFILE = os.environ.get("HERMES_CHROME_AGENT_PROFILE") or os.path.join(HERMES_HOME, "chrome-agent")
TOOLS = os.environ.get("HERMES_CHROME_AGENT_TOOLS") or os.path.join(HERMES_HOME, "chrome-agent-tools")
CHROME = os.environ.get("HERMES_CHROME_AGENT_CHROME") or "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
LABEL = os.environ.get("HERMES_CHROME_AGENT_LABEL") or "com.hermes.chrome-agent"
VDISPLAY = os.path.join(TOOLS, "hermes-vdisplay")
EVICT = os.path.join(TOOLS, "hermes-window-evict")
EVICT_EVERY_S = 2.0   # how often non-Chrome windows are checked for sitting on the virtual display
STATE_DIR = os.path.join(HERMES_HOME, "cache", "chrome-agent")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
SHOW_FLAG = os.path.join(STATE_DIR, "show")
LOG = os.path.join(HERMES_HOME, "logs", "chrome-agent.log")
SRC_DIR = os.path.dirname(os.path.realpath(__file__))
BINDING = "__hermesWebAuthn"
MENU_BAR = 40  # leave room for the virtual display's own menu bar
# Move the window asking for a passkey onto the main display until the request settles (max 120s), so the
# human sees which site they are approving. Off by default: the Touch ID sensor works without seeing it.
SHOW_ON_PASSKEY = os.environ.get("HERMES_CHROME_AGENT_SHOW_ON_PASSKEY", "") not in ("", "0", "false")
NOTIFIER_APP = os.path.join(TOOLS, "Hermes Touch ID.app")
NOTIFIER_BUNDLE_ID = "com.hermes.chrome-agent.notify"
NOTIFIER_BIN = os.path.join(NOTIFIER_APP, "Contents", "MacOS", "hermes-touchid-notify")
NOTIFIER_SETTINGS_URL = ("x-apple.systempreferences:com.apple.Notifications-Settings.extension?id="
                         + NOTIFIER_BUNDLE_ID)
REVEAL_S = 180      # a clicked-through passkey window stays on the main display at most this long
SETTLE_GRACE_S = 3  # after the request settles, keep it shown briefly (sites often retry right away)
FOCUS_GUARD = os.environ.get("HERMES_CHROME_AGENT_FOCUS_GUARD", "1") not in ("", "0", "false")
FOCUS_POLL_S = 0.25   # frontmost-app poll interval of the focus guard
FOCUS_ALLOW_S = 10    # after `show` or a passkey reveal, the agent Chrome may take focus this long
USER_INPUT_S = 1.0    # a click / modifier press this recent means the user brought Chrome forward
FOCUS_RETRY_S = 1.0   # don't re-send the hand-back while the previous one is still landing
FOCUS_MAX_TRIES = 3   # hand-backs per grab before giving up (the target app may be refusing activation)

# Wraps navigator.credentials.get/create and reports the request through a CDP binding. Conditional
# mediation (passkey autofill, fired on page load without user intent) is not reported.
WEBAUTHN_HOOK = r"""(() => {
  try {
    if (window.__hermesWebAuthnHooked || !navigator.credentials) return;
    window.__hermesWebAuthnHooked = true;
    const c = navigator.credentials;
    for (const op of ['get', 'create']) {
      const orig = c[op] && c[op].bind(c);
      if (!orig) continue;
      c[op] = function (opts) {
        try {
          const pk = opts && opts.publicKey;
          if (pk && opts.mediation !== 'conditional' && typeof window.%s === 'function') {
            const report = window.%s, rpId = pk.rpId || (pk.rp && pk.rp.id) || location.hostname;
            report(JSON.stringify({op, origin: location.origin, rpId}));
            const done = (ok, err) => { try { report(JSON.stringify({op: 'done', ok, error: err ? String(err.name || err) : '', origin: location.origin, rpId})); } catch (e) {} };
            const p = orig(opts);
            p.then(() => done(true), (e) => done(false, e));
            return p;
          }
        } catch (e) {}
        return orig(opts);
      };
    }
  } catch (e) {}
})();""" % (BINDING, BINDING)


def log(msg):
    sys.stdout.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
    sys.stdout.flush()


# ---------------------------------------------------------------- minimal CDP websocket client (stdlib)

class CDPError(Exception):
    pass


class CDP:
    """Browser-level CDP connection with flat sessions. One reader thread; call() blocks for its reply."""

    def __init__(self, ws_url, on_event=None, timeout=10):
        rest = ws_url.split("://", 1)[1]
        hostport, path = rest.split("/", 1)
        host, port = hostport.rsplit(":", 1)
        self.sock = socket.create_connection((host, int(port)), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        # No Origin header: Chrome only checks --remote-allow-origins when one is sent.
        req = ("GET /%s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, hostport, key))
        self.sock.sendall(req.encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise CDPError("handshake: connection closed")
            buf += chunk
        head, self._buf = buf.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise CDPError("handshake failed: %r" % head[:200])
        self.sock.settimeout(None)
        self.on_event = on_event
        self.next_id = 0
        self.pending = {}
        self.lock = threading.Lock()
        self.send_lock = threading.Lock()
        self.closed = False
        self.reader = threading.Thread(target=self._read_loop, daemon=True)
        self.reader.start()

    def _recv_exact(self, n):
        while len(self._buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise CDPError("connection closed")
            self._buf += chunk
        out, self._buf = self._buf[:n], self._buf[n:]
        return out

    def _read_frame(self):
        b1, b2 = self._recv_exact(2)
        op, ln = b1 & 0x0F, b2 & 0x7F
        if ln == 126:
            ln = struct.unpack(">H", self._recv_exact(2))[0]
        elif ln == 127:
            ln = struct.unpack(">Q", self._recv_exact(8))[0]
        mask = self._recv_exact(4) if b2 & 0x80 else None
        data = self._recv_exact(ln)
        if mask:
            data = bytes(c ^ mask[i % 4] for i, c in enumerate(data))
        return b1 & 0x80, op, data

    def _read_loop(self):
        msg, msg_op = b"", None
        try:
            while True:
                fin, op, data = self._read_frame()
                if op == 8:
                    break
                if op == 9:
                    self._send_frame(10, data)
                    continue
                if op in (1, 2):
                    msg, msg_op = data, op
                elif op == 0:
                    msg += data
                else:
                    continue
                if not fin:
                    continue
                self._dispatch(json.loads(msg.decode("utf-8")))
                msg = b""
        except Exception:
            pass
        finally:
            self.closed = True
            with self.lock:
                for ev in self.pending.values():
                    ev[1] = {"error": {"message": "connection closed"}}
                    ev[0].set()

    def _dispatch(self, m):
        if "id" in m:
            with self.lock:
                slot = self.pending.pop(m["id"], None)
            if slot:
                slot[1] = m
                slot[0].set()
        elif self.on_event:
            try:
                self.on_event(m)
            except Exception as e:  # never kill the reader on a handler bug
                log("event handler error: %s" % e)

    def _send_frame(self, op, payload):
        hdr = bytes([0x80 | op])
        n = len(payload)
        if n < 126:
            hdr += bytes([0x80 | n])
        elif n < 65536:
            hdr += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            hdr += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        body = bytes(c ^ mask[i % 4] for i, c in enumerate(payload))
        with self.send_lock:
            self.sock.sendall(hdr + mask + body)

    def call(self, method, params=None, session=None, timeout=10):
        if self.closed:
            raise CDPError("connection closed")
        with self.lock:
            self.next_id += 1
            mid = self.next_id
            slot = [threading.Event(), None]
            self.pending[mid] = slot
        msg = {"id": mid, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        self._send_frame(1, json.dumps(msg).encode())
        if not slot[0].wait(timeout):
            with self.lock:
                self.pending.pop(mid, None)
            raise CDPError("%s timed out" % method)
        r = slot[1]
        if "error" in r:
            raise CDPError("%s: %s" % (method, r["error"].get("message")))
        return r.get("result", {})

    def close(self):
        self.closed = True
        try:
            self.sock.close()
        except Exception:
            pass


def cdp_version(timeout=1.0, port=None):
    """/json/version of Chrome itself (internal port) unless `port` names another endpoint."""
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/json/version" % (port or CHROME_PORT), timeout=timeout) as r:
            return json.load(r)
    except Exception:
        return None


# ---------------------------------------------------------------- CDP focus filter (proxy on PORT -> CHROME_PORT)
#
# Any local process can talk CDP to the shared agent Chrome, and three CDP calls make macOS hand that Chrome
# keyboard focus: a foreground Target.createTarget, Target.activateTarget and Page.bringToFront (plus their
# HTTP twins /json/activate/<id> and PUT /json/new). The focus guard can only hand focus back after the steal.
# So Chrome listens on an internal port and the supervisor serves the public port as a transparent proxy that
# rewrites those calls unless the show flag is set (`hermes-chrome-agent show`, browser_focus).

WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
_RAISING = (b"createTarget", b"activateTarget", b"bringToFront")
_SWALLOWED = ("Target.activateTarget", "Page.bringToFront")


def show_active():
    """The user asked to see the agent Chrome: raising calls pass through untouched."""
    return os.path.exists(SHOW_FLAG) and not show_expired()


def filter_cdp_message(m, show):
    """Focus-filter rule for one client->Chrome CDP message.
    None = forward unchanged; ("forward", msg) = forward the rewritten msg (a raise was neutralised, logged);
    ("window", msg) = forward the rewritten msg (own window only, not logged); ("reply", msg) = answer the client.

    Target.createTarget always ends up background. Unless the show flag is set it also gets its own window
    (newWindow: true): Chrome stalls Page.enable / Runtime.enable on a background tab inside an existing window
    (the tab is never visible), while a background tab alone in its own window loads and does not raise Chrome."""
    if show or not isinstance(m, dict):
        return None
    method = m.get("method")
    if method == "Target.createTarget":
        p0 = m.get("params") if isinstance(m.get("params"), dict) else {}
        p = dict(p0, background=True)
        p.pop("focus", None)
        if not (p.get("hidden") or p.get("forTab")):
            p["newWindow"] = True
        if p == p0:
            return None
        raised = p0.get("background") is not True or bool(p0.get("focus"))
        return ("forward" if raised else "window"), dict(m, params=p)
    if method in _SWALLOWED and "id" in m:
        r = {"id": m["id"], "result": {}}
        if "sessionId" in m:
            r["sessionId"] = m["sessionId"]
        return "reply", r
    return None


def filter_http(method, target, show):
    """Focus-filter rule for one HTTP request: None = forward; ("activate", id); ("new", url)."""
    if show:
        return None
    path, _, query = target.partition("?")
    if path.startswith("/json/activate/"):
        return "activate", path[len("/json/activate/"):]
    if path == "/json/new" and method.upper() == "PUT":
        return "new", urllib.parse.unquote(query)
    return None


def peer_desc(peer_port):
    """`pid N (command)` of the local process on the client end of a loopback connection (lsof)."""
    try:
        out = subprocess.run(["/usr/sbin/lsof", "-nP", "-Fpn", "-iTCP@127.0.0.1:%d" % peer_port],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True,
                             timeout=3).stdout
        pids, cur = [], None
        for l in out.splitlines():           # p<pid> then n<local>-><remote> per socket; the client owns local
            if l.startswith("p"):
                cur = int(l[1:])
            elif l.startswith("n") and l[1:].split("->")[0].endswith(":%d" % peer_port) and cur not in pids:
                pids.append(cur)
        if not pids:
            return "port %d (pid unknown)" % peer_port
        pid = pids[0]
        ps = lambda field: subprocess.run(["/bin/ps", "-o", field + "=", "-p", str(pid)], stdout=subprocess.PIPE,
                                          stderr=subprocess.DEVNULL, universal_newlines=True, timeout=3).stdout.strip()
        exe, args, ppid = ps("comm"), ps("args"), ps("ppid")
        if exe and args.startswith(exe):      # long interpreter paths would eat the whole budget
            args = os.path.basename(exe) + args[len(exe):]
        return "pid %d (%s; ppid %s)" % (pid, args[:160], ppid or "?")
    except Exception as e:
        return "port %d (lsof failed: %s)" % (peer_port, e)


class _Reader:
    """Buffered exact reads from a socket."""

    def __init__(self, sock, buf=b""):
        self.sock, self.buf = sock, buf

    def read(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(max(65536, n - len(self.buf)))
            if not chunk:
                raise EOFError("connection closed")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def read_head(self, limit=65536):
        """Bytes up to and excluding the blank line ending an HTTP head; None if closed first."""
        while b"\r\n\r\n" not in self.buf:
            if len(self.buf) > limit:
                return None
            chunk = self.sock.recv(65536)
            if not chunk:
                return None
            self.buf += chunk
        head, self.buf = self.buf.split(b"\r\n\r\n", 1)
        return head


def _xor(data, mask):
    if not data:
        return data
    n = len(data)
    key = (mask * (n // 4 + 1))[:n]
    return (int.from_bytes(data, "big") ^ int.from_bytes(key, "big")).to_bytes(n, "big")


def read_frame(r):
    """(raw frame bytes, fin, opcode, unmasked payload) from a _Reader."""
    h = r.read(2)
    b1, b2 = h[0], h[1]
    raw = h
    ln = b2 & 0x7F
    if ln == 126:
        x = r.read(2)
        raw += x
        ln = struct.unpack(">H", x)[0]
    elif ln == 127:
        x = r.read(8)
        raw += x
        ln = struct.unpack(">Q", x)[0]
    mask = None
    if b2 & 0x80:
        mask = r.read(4)
        raw += mask
    data = r.read(ln)
    raw += data
    return raw, bool(b1 & 0x80), b1 & 0x0F, _xor(data, mask) if mask else data


def encode_frame(op, payload, mask):
    hdr = bytes([0x80 | op])
    n = len(payload)
    mbit = 0x80 if mask else 0
    if n < 126:
        hdr += bytes([mbit | n])
    elif n < 65536:
        hdr += bytes([mbit | 126]) + struct.pack(">H", n)
    else:
        hdr += bytes([mbit | 127]) + struct.pack(">Q", n)
    if not mask:
        return hdr + payload
    k = os.urandom(4)
    return hdr + k + _xor(payload, k)


class CDPProxy:
    """Transparent CDP proxy 127.0.0.1:port -> 127.0.0.1:upstream (HTTP /json/* and websockets) that applies
    the focus filter. port=0 binds an ephemeral port (tests); the bound port is in .port."""

    def __init__(self, port, upstream, show=show_active, logf=None):
        self.want_port, self.upstream = port, upstream
        self.port = port
        self.show = show
        self.logf = logf or log
        self.srv = None
        self.closed = False
        self.peers = {}   # client port -> `pid N (cmd)` while that connection is open

    # -- lifecycle
    def start(self, wait=True):
        """Bind (retrying while a previous Chrome/supervisor still holds the port) and serve in threads."""
        def bind_loop():
            logged = False
            while not self.closed:
                try:
                    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                    s.bind(("127.0.0.1", self.want_port))
                    s.listen(128)
                    self.srv, self.port = s, s.getsockname()[1]
                    self.logf("cdp-proxy: 127.0.0.1:%d -> Chrome 127.0.0.1:%d (focus filter on)"
                              % (self.port, self.upstream))
                    break
                except OSError as e:
                    s.close()
                    if not logged:
                        logged = True
                        self.logf("cdp-proxy: cannot bind 127.0.0.1:%d yet (%s); retrying" % (self.want_port, e))
                    time.sleep(1)
            if self.srv:
                self._accept_loop()
        t = threading.Thread(target=bind_loop, daemon=True)
        t.start()
        deadline = time.time() + 5
        while wait and self.srv is None and time.time() < deadline:
            time.sleep(0.01)
        return self

    def close(self):
        self.closed = True
        if self.srv:
            try:
                self.srv.close()
            except OSError:
                pass

    def _accept_loop(self):
        while not self.closed:
            try:
                c, addr = self.srv.accept()
            except OSError:
                if self.closed:
                    return
                time.sleep(0.1)
                continue
            threading.Thread(target=self._serve, args=(c, addr), daemon=True).start()

    def _rewrite(self, peer_port, what):
        who = self.peers.get(peer_port)
        if who is None:
            if len(self.peers) > 256:
                self.peers.clear()
            who = self.peers[peer_port] = peer_desc(peer_port)
        self.logf("focus-filter: %s from %s rewritten" % (what, who))

    def _fix_ports(self, body):
        for h in (b"127.0.0.1", b"localhost"):
            body = body.replace(h + b":%d" % self.upstream, h + b":%d" % self.port)
        return body

    # -- one client connection
    def _serve(self, c, addr):
        try:
            r = _Reader(c)
            head = r.read_head()
            if head is None:
                return
            lines = head.decode("latin-1").split("\r\n")
            parts = lines[0].split(" ")
            if len(parts) < 3:
                return
            method, target = parts[0], parts[1]
            headers = [tuple(x.strip() for x in l.split(":", 1)) for l in lines[1:] if ":" in l]
            hmap = {k.lower(): v for k, v in headers}
            if hmap.get("upgrade", "").lower() == "websocket":
                self._ws(c, r, lines[0], headers, addr)
            else:
                body = r.read(int(hmap.get("content-length") or 0))
                self._http(c, method, target, headers, body, addr)
        except Exception as e:
            if not self.closed:
                self.logf("cdp-proxy: connection from port %d: %s" % (addr[1], e))
        finally:
            self.peers.pop(addr[1], None)
            try:
                c.close()
            except OSError:
                pass

    @staticmethod
    def _respond(c, status, reason, body, ctype="text/plain"):
        if isinstance(body, str):
            body = body.encode()
        c.sendall(("HTTP/1.1 %d %s\r\nContent-Type: %s\r\nContent-Length: %d\r\nConnection: close\r\n\r\n"
                   % (status, reason, ctype, len(body))).encode() + body)

    def _http(self, c, method, target, headers, body, addr):
        import http.client
        rule = filter_http(method, target, self.show())
        if rule and rule[0] == "activate":
            self._rewrite(addr[1], "/json/activate")
            self._respond(c, 200, "OK", "Target activated")
            return
        if rule and rule[0] == "new":
            self._rewrite(addr[1], "/json/new")
            self._respond(c, 200, "OK", json.dumps(self._new_background(rule[1]), indent=3), "application/json")
            return
        up = http.client.HTTPConnection("127.0.0.1", self.upstream, timeout=30)
        try:
            hdrs = {k: v for k, v in headers if k.lower() not in ("connection", "keep-alive", "content-length")}
            up.request(method, target, body=body or None, headers=hdrs)
            resp = up.getresponse()
            data = self._fix_ports(resp.read())
            out = "HTTP/1.1 %d %s\r\n" % (resp.status, resp.reason)
            for k, v in resp.getheaders():
                if k.lower() not in ("content-length", "connection", "transfer-encoding", "keep-alive"):
                    out += "%s: %s\r\n" % (k, v)
            out += "Content-Length: %d\r\nConnection: close\r\n\r\n" % len(data)
            c.sendall(out.encode("latin-1") + data)
        finally:
            up.close()

    def _new_background(self, url):
        """PUT /json/new?url without raising: Target.createTarget background:true, answered like Chrome would."""
        v = cdp_version(timeout=5, port=self.upstream)
        if not v:
            raise CDPError("Chrome not answering on %d" % self.upstream)
        cdp = CDP(v["webSocketDebuggerUrl"])
        try:
            tid = cdp.call("Target.createTarget", {"url": url or "about:blank", "background": True,
                                                  "newWindow": True})["targetId"]
        finally:
            cdp.close()
        for _ in range(20):
            try:
                with urllib.request.urlopen("http://127.0.0.1:%d/json/list" % self.upstream, timeout=5) as resp:
                    for t in json.loads(self._fix_ports(resp.read())):
                        if t.get("id") == tid:
                            return t
            except Exception:
                pass
            time.sleep(0.05)
        return {"id": tid, "type": "page", "url": url or "about:blank",
                "webSocketDebuggerUrl": "ws://127.0.0.1:%d/devtools/page/%s" % (self.port, tid)}

    def _ws(self, c, r, request_line, headers, addr):
        up = socket.create_connection(("127.0.0.1", self.upstream), timeout=30)
        try:
            # Drop compression offers: a permessage-deflate stream could not be inspected.
            head = request_line + "\r\n" + "".join("%s: %s\r\n" % (k, v) for k, v in headers
                                                   if k.lower() != "sec-websocket-extensions") + "\r\n"
            up.sendall(head.encode("latin-1"))
            ur = _Reader(up)
            resp = ur.read_head()
            if resp is None:
                return
            c.sendall(resp + b"\r\n\r\n")
            if b" 101 " not in resp.split(b"\r\n", 1)[0]:
                c.sendall(ur.buf)   # e.g. Chrome's 403 for a bad Origin, then it closes
                return
            up.settimeout(None)
            c.settimeout(None)
            to_client = threading.Lock()
            threading.Thread(target=self._pump_down, args=(ur, c, up, to_client), daemon=True).start()
            self._pump_up(r, up, c, to_client, addr)
        finally:
            try:
                up.close()
            except OSError:
                pass

    def _pump_down(self, ur, c, up, lock):
        """Chrome -> client, frame by frame so locally answered replies never land inside a fragmented message."""
        held = False   # the lock stays held from the first to the last frame of a fragmented message
        try:
            while True:
                raw, fin, op, _ = read_frame(ur)
                if op >= 8 and held:          # control frame between fragments
                    c.sendall(raw)
                elif op >= 8:
                    with lock:
                        c.sendall(raw)
                else:
                    if not held:
                        lock.acquire()
                        held = True
                    c.sendall(raw)
                    if fin:
                        lock.release()
                        held = False
                if op == 8:
                    break
        except Exception:
            pass
        finally:
            if held:
                lock.release()
            for s in (c, up):
                try:
                    s.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass

    def _pump_up(self, r, up, c, lock, addr):
        """Client -> Chrome: inspect each complete message and apply the focus filter."""
        frames, payload = [], b""
        try:
            while True:
                raw, fin, op, data = read_frame(r)
                if op >= 8:                    # control frames: pass straight through
                    up.sendall(raw)
                    if op == 8:
                        break
                    continue
                frames.append(raw)
                payload += data
                if not fin:
                    continue
                msg_frames, msg, frames, payload = frames, payload, [], b""
                act = None
                if any(k in msg for k in _RAISING):
                    try:
                        act = filter_cdp_message(json.loads(msg.decode("utf-8")), self.show())
                    except ValueError:
                        act = None
                if act is None:
                    up.sendall(b"".join(msg_frames))
                    continue
                kind, out = act
                if kind != "window":
                    self._rewrite(addr[1], out.get("method") if kind == "forward" else json.loads(msg)["method"])
                if kind in ("forward", "window"):
                    up.sendall(encode_frame(1, json.dumps(out).encode(), mask=True))
                else:
                    with lock:
                        c.sendall(encode_frame(1, json.dumps(out).encode(), mask=False))
        except Exception:
            pass
        finally:
            for s in (c, up):
                try:
                    s.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass


# ---------------------------------------------------------------- supervisor

def parse_rect(s):
    xy, wh = s.split(" ")
    x, y = xy.split(",")
    w, h = wh.split("x")
    return [int(x), int(y), int(w), int(h)]


def inside(b, r, tol=2):
    return (b["left"] >= r[0] - tol and b["top"] >= r[1] - tol
            and b["left"] + b["width"] <= r[0] + r[2] + tol and b["top"] + b["height"] <= r[1] + r[3] + tol)


def activate_pid(pid):
    """Bring an app to the front (JXA, no Accessibility grant needed). macOS may refuse this from a background
    process; the notifier app, frontmost right after the click, hands activation over as well."""
    js = ('ObjC.import("AppKit"); var a=$.NSRunningApplication.runningApplicationWithProcessIdentifier(%d);'
          ' a ? a.activateWithOptions(3) : false' % pid)
    try:
        subprocess.Popen(["/usr/bin/osascript", "-l", "JavaScript", "-e", js],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        log("activate failed: %s" % e)


def front_pid():
    """Pid of the frontmost app (lsappinfo: no Accessibility or Screen Recording grant needed)."""
    try:
        asn = subprocess.run(["/usr/bin/lsappinfo", "front"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             universal_newlines=True, timeout=2).stdout.strip()
        if not asn:
            return None
        out = subprocess.run(["/usr/bin/lsappinfo", "info", "-only", "pid", asn], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, universal_newlines=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r"=\s*(\d+)", out)
    return int(m.group(1)) if m else None


def app_name(pid):
    try:
        asn = subprocess.run(["/usr/bin/lsappinfo", "find", "pid=%d" % pid], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, universal_newlines=True, timeout=2).stdout.strip()
        out = subprocess.run(["/usr/bin/lsappinfo", "info", "-only", "name", asn], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, universal_newlines=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return "?"
    m = re.search(r'="([^"]*)"', out)
    return m.group(1) if m else "?"


_CG = []


def user_input_age():
    """Seconds since the user's last mouse click or modifier press (Cmd-Tab), HID-wide. Plain key presses
    are left out on purpose: the user typing in another app is exactly when a stolen focus hurts."""
    try:
        if not _CG:
            import ctypes
            cg = ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
            f = cg.CGEventSourceSecondsSinceLastEventType
            f.restype, f.argtypes = ctypes.c_double, [ctypes.c_int, ctypes.c_uint32]
            _CG.append(f)
        f = _CG[0]
        # 1 = kCGEventSourceStateHIDSystemState; 1/3/25 = left/right/other mouse down, 12 = flagsChanged
        return min(f(1, 1), f(1, 3), f(1, 25), f(1, 12))
    except Exception:
        return float("inf")


def show_age(now=None):
    try:
        return (now or time.time()) - os.path.getmtime(SHOW_FLAG)
    except OSError:
        return float("inf")


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True
    except OSError:
        return False


class FocusGuard:
    """Decides, one poll at a time, whether the agent Chrome's turn as frontmost app was asked for. A grant
    lasts until Chrome loses focus, so the user can keep working in a shown window."""

    def __init__(self):
        self.prev = None          # last frontmost app that is not the agent Chrome
        self.granted = False
        self.allow_until = 0.0
        self.returned_at = 0.0
        self.tries = 0

    def allow(self, seconds=FOCUS_ALLOW_S, now=None):
        self.allow_until = (now or time.time()) + seconds

    def step(self, front, chrome_pid, now, input_age, shown_age):
        """Returns the pid to hand focus back to, or None."""
        if front is None or chrome_pid is None:
            return None
        if front != chrome_pid:
            self.prev, self.granted, self.tries = front, False, 0
            return None
        if self.granted:
            return None
        if now < self.allow_until or shown_age < FOCUS_ALLOW_S or input_age < USER_INPUT_S:
            self.granted = True
            return None
        if self.prev and not pid_alive(self.prev):
            self.prev = None      # the app we would return to quit (e.g. Desktop restarting): nothing to do
        if not self.prev or now - self.returned_at < FOCUS_RETRY_S:
            return None
        if self.tries >= FOCUS_MAX_TRIES:
            self.granted = True   # macOS keeps refusing the hand-back: stop fighting until Chrome loses focus
            return None
        self.tries += 1
        self.returned_at = now
        return self.prev


class Supervisor:
    def __init__(self):
        self.vd = None
        self.chrome = None
        self.vbounds = None
        self.main = None
        self.cdp = None
        self.hooked = set()
        self.last_notice = {}
        self.sess_target = {}
        self.passkey = None  # {"target": id, "until": t, "wid": windowId|None} while a request is pending
        self.stop = False
        self.chrome_fails = 0
        self.shown = False
        self.evict_next = 0.0
        self.evict_untrusted_logged = False
        self.notices = {}   # targetId -> running notifier Popen (its notification is still on screen)
        self.focus = FocusGuard()
        self.proxy = None

    # -- children
    def start_vdisplay(self):
        if not os.path.exists(VDISPLAY):
            raise SystemExit("missing %s (run: hermes-chrome-agent install)" % VDISPLAY)
        self.vbounds = None
        self.vd = subprocess.Popen([VDISPLAY], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   universal_newlines=True, bufsize=1)
        threading.Thread(target=self._vd_reader, args=(self.vd,), daemon=True).start()
        deadline = time.time() + 10
        while self.vbounds is None and time.time() < deadline and self.vd.poll() is None:
            time.sleep(0.1)
        log("vdisplay pid %d bounds %s main %s" % (self.vd.pid, self.vbounds, self.main))

    def _vd_reader(self, proc):
        for line in proc.stdout:
            line = line.strip()
            if " bounds " in line:
                try:
                    rest = line.split(" bounds ", 1)[1]
                    own, _, main = rest.partition(" main ")
                    self.vbounds = parse_rect(own)
                    if main:
                        self.main = parse_rect(main)
                    log("vdisplay: " + line)
                except Exception:
                    log("vdisplay unparsed: " + line)
            elif line:
                log("vdisplay: " + line)

    def _kill_stale_chrome(self):
        """A Chrome left on our profile (previous supervisor SIGKILLed, manual launch) would swallow our
        launch (macOS hands the request to the running instance). The profile is dedicated, so stop it."""
        lock = os.path.join(PROFILE, "SingletonLock")
        try:
            pid = int(os.readlink(lock).rsplit("-", 1)[1])
        except Exception:
            return
        if self.chrome and pid == self.chrome.pid:
            return
        try:
            os.kill(pid, 0)
        except OSError:
            return
        log("stopping stale Chrome pid %d holding %s" % (pid, PROFILE))
        os.kill(pid, signal.SIGTERM)
        for _ in range(100):
            time.sleep(0.1)
            try:
                os.kill(pid, 0)
            except OSError:
                return
        os.kill(pid, signal.SIGKILL)
        time.sleep(0.5)

    def _prefs_off_savers(self):
        """Memory Saver discards hidden tabs and Energy Saver freezes them; agent sessions live in hidden
        tabs. Chrome rewrites Local State on exit, so set this while Chrome is down."""
        path = os.path.join(PROFILE, "Local State")
        try:
            with open(path) as f:
                st = json.load(f)
        except Exception:
            st = {}
        pt = st.setdefault("performance_tuning", {})
        changed = False
        for k in ("high_efficiency_mode", "battery_saver_mode"):
            if pt.get(k, {}).get("state") != 0:
                pt.setdefault(k, {})["state"] = 0
                changed = True
        if changed:
            with open(path + ".tmp", "w") as f:
                json.dump(st, f)
            os.replace(path + ".tmp", path)
            log("Local State: Memory Saver / Energy Saver forced off")

    def start_chrome(self):
        self._kill_stale_chrome()
        os.makedirs(PROFILE, exist_ok=True)
        self._prefs_off_savers()
        args = [CHROME, "--user-data-dir=" + PROFILE, "--remote-debugging-port=%d" % CHROME_PORT,
                "--remote-debugging-address=127.0.0.1",
                "--remote-allow-origins=" + ",".join("http://%s:%d" % (h, p) for p in sorted({PORT, CHROME_PORT})
                                                     for h in ("127.0.0.1", "localhost")),
                "--no-first-run", "--no-default-browser-check", "--hide-crash-restore-bubble",
                "--disable-backgrounding-occluded-windows", "--disable-renderer-backgrounding",
                "--disable-background-timer-throttling", "about:blank"]
        if self.vbounds:
            args.insert(-1, "--window-position=%d,%d" % (self.vbounds[0], self.vbounds[1] + MENU_BAR))
        self.chrome = subprocess.Popen(args, stdout=sys.stdout, stderr=subprocess.STDOUT)
        log("chrome pid %d started" % self.chrome.pid)
        self.hooked.clear()
        deadline = time.time() + 30
        while time.time() < deadline and self.chrome.poll() is None:
            if cdp_version():
                return
            time.sleep(0.2)
        log("chrome CDP did not come up within 30s")

    def stop_children(self):
        for name, p in (("chrome", self.chrome), ("vdisplay", self.vd)):
            if p and p.poll() is None:
                p.terminate()
                try:
                    p.wait(10)
                except subprocess.TimeoutExpired:
                    p.kill()
                log("%s stopped" % name)

    # -- CDP
    def connect(self):
        if self.cdp and not self.cdp.closed:
            return self.cdp
        v = cdp_version()
        if not v:
            return None
        self.cdp = CDP(v["webSocketDebuggerUrl"], on_event=self.on_event)
        self.hooked.clear()
        self.cdp.call("Target.setDiscoverTargets", {"discover": True})
        self.cdp.call("Target.setAutoAttach", {"autoAttach": True, "waitForDebuggerOnStart": False, "flatten": True})
        log("CDP connected")
        return self.cdp

    def hook_session(self, session, info=None):
        c = self.cdp
        try:
            # Page.enable keeps the script across cross-process navigations and Runtime.enable keeps the
            # binding; without them the hook silently disappears on the first cross-site navigation.
            c.call("Page.enable", {}, session=session, timeout=30)
            c.call("Runtime.enable", {}, session=session, timeout=30)
            c.call("Runtime.addBinding", {"name": BINDING}, session=session, timeout=30)
            c.call("Page.addScriptToEvaluateOnNewDocument", {"source": WEBAUTHN_HOOK}, session=session, timeout=30)
            c.call("Runtime.evaluate", {"expression": WEBAUTHN_HOOK}, session=session, timeout=30)
            log("webauthn hook installed in %s" % ((info or {}).get("url", "")[:80] or session))
        except Exception as e:
            log("hook failed (%s): %s" % ((info or {}).get("url", "")[:80], e))

    def on_event(self, m):
        method = m.get("method")
        p = m.get("params", {})
        if method == "Target.attachedToTarget":
            info = p.get("targetInfo", {})
            sid = p.get("sessionId")
            if info.get("type") == "page" and sid not in self.hooked:
                self.hooked.add(sid)
                self.sess_target[sid] = info.get("targetId")
                threading.Thread(target=self.hook_session, args=(sid, info), daemon=True).start()
        elif method == "Target.detachedFromTarget":
            self.hooked.discard(p.get("sessionId"))
        elif method == "Runtime.bindingCalled" and p.get("name") == BINDING:
            try:
                req = json.loads(p.get("payload") or "{}")
            except ValueError:
                req = {}
            site = req.get("rpId") or req.get("origin") or "a site"
            log("webauthn %s %s from %s" % (req.get("op"), ("settled ok=%s %s" % (req.get("ok"), req.get("error") or ""))
                                             if req.get("op") == "done" else "request", req.get("origin")))
            target = self.sess_target.get(m.get("sessionId"))
            if req.get("op") == "done":
                self.settled(target, req.get("ok") is not False)
                return
            op = "sign in with" if req.get("op") == "get" else "create"
            now = time.time()
            if SHOW_ON_PASSKEY:
                self.passkey = {"target": target, "until": now + 120, "wid": None}
            if now - self.last_notice.get(site, 0) > 10 and not self._notice_live(target):
                self.last_notice[site] = now
                self.notify_passkey(target, "Hermes needs Touch ID", "Tap Touch ID to %s a passkey for %s" % (op, site))

    # -- clickable passkey notification
    def _notice_live(self, target):
        p = self.notices.get(target)
        return bool(p and p.poll() is None)

    def notify_passkey(self, target, title, text):
        """Post via Hermes Touch ID.app so a click comes back to us. Without the app nothing clickable can be
        posted (an osascript notification opens Script Editor when clicked), so reveal the asking tab at once."""
        if not os.access(NOTIFIER_BIN, os.X_OK):
            log("NOTIFIER MISSING (%s): revealing the passkey tab directly; run `hermes-chrome-agent install`"
                % NOTIFIER_BIN)
            self.reveal(target)
            return None
        try:
            proc = subprocess.Popen([NOTIFIER_BIN, "--title", title, "--body", text, "--timeout", str(REVEAL_S)],
                                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                    universal_newlines=True, bufsize=1)
        except Exception as e:
            log("NOTIFIER FAILED to start (%s): revealing the passkey tab directly" % e)
            self.reveal(target)
            return None
        self.notices[target] = proc
        threading.Thread(target=self._notice_reader, args=(proc, target, title, text), daemon=True).start()
        return proc

    def _notice_reader(self, proc, target, title, text):
        for line in proc.stdout:
            self.on_notifier_line(line, target, proc, title, text)

    def on_notifier_line(self, line, target, proc, title="", text=""):
        line = line.strip()
        if line.startswith("error not authorized"):
            # The app now shows a floating alert with a Show button; put the window in front of the human
            # already (no activation, which would bury the alert), so the passkey is never stuck out of sight.
            log("NOTIFICATIONS OFF for Hermes Touch ID (%s): passkey window revealed, alert shown instead. "
                "Allow them: open '%s'" % (line, NOTIFIER_SETTINGS_URL))
            self.reveal(target, activate=False)
        elif line.startswith("error"):
            log("notifier: %s; revealing the passkey tab directly" % line)
            self.reveal(target, proc)
        elif line in ("action default", "action show"):
            log("notifier: %s clicked for target %s" % ("notification" if line.endswith("default") else "Show",
                                                         target))
            self.reveal(target, proc)
        elif line:
            log("notifier: " + line)

    def reveal(self, target, proc=None, activate=True):
        """The human clicked the passkey notification: put the window holding `target` on the main display,
        select that tab, bring Chrome forward, and keep re-homing off it until the request settles."""
        c = self.cdp
        chrome_pid = self.chrome.pid if self.chrome else None
        wid = None
        self.focus.allow()
        if c and target and self.main:
            try:
                w = c.call("Browser.getWindowForTarget", {"targetId": target})
                wid = w["windowId"]
                self.passkey = {"target": target, "until": time.time() + REVEAL_S, "wid": wid}
                self.place(wid, w["bounds"], self.main_rect())
                c.call("Target.activateTarget", {"targetId": target})
                log("passkey: window %d -> main display, tab %s selected" % (wid, target))
            except CDPError as e:
                log("passkey reveal failed: %s" % e)
        if chrome_pid and activate:
            if proc and proc.poll() is None:
                try:
                    proc.stdin.write("activate %d\n" % chrome_pid)
                    proc.stdin.write("exit\n")
                    proc.stdin.flush()
                except (OSError, ValueError):
                    pass
            activate_pid(chrome_pid)
        return wid

    def settled(self, target, ok=True):
        """WebAuthn request finished. A hidden tab's request usually fails at once (NotAllowedError: the page
        is not focused), and sites retry or show "Try again": keep the notification and any revealed window
        so the human can finish in front. Only success withdraws the notification and sends the window home
        after a short grace."""
        if not ok:
            if self.passkey and self.passkey.get("target") == target and self.passkey.get("wid") is None:
                self.passkey = None   # auto-show (SHOW_ON_PASSKEY) of a failed request: nothing to look at
            return
        p = self.notices.pop(target, None)
        if p and p.poll() is None:
            p.terminate()
        pk = self.passkey
        if pk and pk.get("target") == target:
            if pk.get("wid") is not None:
                pk["until"] = min(pk["until"], time.time() + SETTLE_GRACE_S)
            else:
                self.passkey = None

    def windows(self):
        c = self.cdp
        seen = {}
        for t in c.call("Target.getTargets").get("targetInfos", []):
            if t.get("type") != "page":
                continue
            try:
                w = c.call("Browser.getWindowForTarget", {"targetId": t["targetId"]})
            except CDPError:
                continue
            seen.setdefault(w["windowId"], (w["bounds"], t))
        return seen

    def place(self, wid, bounds, rect):
        c = self.cdp
        if bounds.get("windowState", "normal") != "normal":
            c.call("Browser.setWindowBounds", {"windowId": wid, "bounds": {"windowState": "normal"}})
        target = {"left": rect[0], "top": rect[1] + MENU_BAR,
                  "width": rect[2], "height": rect[3] - MENU_BAR}
        c.call("Browser.setWindowBounds", {"windowId": wid, "bounds": target})
        # Chrome's tab-modal dialogs (e.g. "Use a saved passkey for <site>") don't follow a window moved to
        # another display: they stay clamped to the old one, so a revealed passkey tab showed a dimmed page
        # with its dialog still on the virtual display. A resize re-anchors them on the window.
        c.call("Browser.setWindowBounds", {"windowId": wid, "bounds": {"width": target["width"] - 1}})
        c.call("Browser.setWindowBounds", {"windowId": wid, "bounds": {"width": target["width"]}})
        return target

    def main_rect(self):
        m = self.main
        return [m[0] + 80, m[1] + 40, min(1400, m[2] - 160), min(900, m[3] - 80)]

    def rehome(self):
        show = os.path.exists(SHOW_FLAG)
        if show and show_expired():
            os.remove(SHOW_FLAG)
            log("show: timed out, re-homing resumed")
            show = False
        if show:
            if self.shown or not self.main:
                return
            rect = self.main_rect()
            for wid, (b, t) in self.windows().items():
                self.place(wid, b, rect)
                log("show: window %d -> main display (%s)" % (wid, t.get("url", "")[:80]))
            self.shown = True
            return
        self.shown = False
        if not self.vbounds:
            return
        pk = self.passkey
        if pk and time.time() > pk["until"]:
            self.passkey = pk = None
        for wid, (b, t) in self.windows().items():
            pk = self.passkey or pk  # a notification click may have revealed a window meanwhile
            if pk and self.main and (wid == pk["wid"] or (pk["wid"] is None and t.get("targetId") == pk["target"])):
                if pk["wid"] is None:
                    pk["wid"] = wid
                    self.place(wid, b, self.main_rect())
                    log("passkey: window %d -> main display (%s)" % (wid, t.get("url", "")[:80]))
                continue
            # A display-filling window reports "maximized" (zoomed) on macOS; that is still home.
            if b.get("windowState", "normal") in ("normal", "maximized") and inside(b, self.vbounds):
                continue
            nb = self.place(wid, b, self.vbounds)
            log("rehome: window %d %s -> %s (%s)" % (wid, {k: b.get(k) for k in ("left", "top", "width", "height", "windowState")},
                                                  nb, t.get("url", "")[:80]))

    def evict(self, now=None):
        """Every EVICT_EVERY_S: move windows of apps other than the agent Chrome off the virtual display.

        Runs the hermes-window-evict helper (needs Accessibility for this process's interpreter). It prints one
        `evict ...` line per move, or `untrusted` (logged once per supervisor run) when the grant is missing."""
        now = time.time() if now is None else now
        if now < self.evict_next or not self.vbounds or not os.path.exists(EVICT):
            return
        self.evict_next = now + EVICT_EVERY_S
        cmd = [EVICT] + [str(n) for n in self.vbounds]
        for p in (self.chrome, self.vd):
            if p is not None:
                cmd += ["--skip-pid", str(p.pid)]
        try:
            out = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                 universal_newlines=True, timeout=5).stdout
        except (subprocess.TimeoutExpired, OSError) as e:
            log("evict: helper failed: %s" % e)
            return
        for line in out.splitlines():
            line = line.strip()
            if line == "untrusted":
                if not self.evict_untrusted_logged:
                    self.evict_untrusted_logged = True
                    log("evict: untrusted: this interpreter lacks Accessibility, so other apps' windows on the "
                        "virtual display are not moved. Install with HERMES_CHROME_AGENT_PYTHON=<an interpreter "
                        "that holds Accessibility>")
            elif line:
                log(line)

    def focus_loop(self):
        """Give keyboard focus back when a CDP client raised the agent Chrome without anyone asking."""
        last_err = 0.0
        while not self.stop:
            try:
                chrome_pid = self.chrome.pid if self.chrome and self.chrome.poll() is None else None
                front = front_pid() if chrome_pid else None
                now = time.time()
                back = self.focus.step(front, chrome_pid, now, user_input_age() if front == chrome_pid else 1e9,
                                       show_age(now))
                if back:
                    log("focus-guard: agent Chrome took focus with no show/passkey/user click; returned it to "
                        "pid %d (%s)" % (back, app_name(back)))
                    activate_pid(back)
            except Exception as e:
                if time.time() - last_err > 60:
                    last_err = time.time()
                    log("focus-guard: %s" % e)
            time.sleep(FOCUS_POLL_S)

    def write_state(self):
        st = {"pid": os.getpid(), "port": PORT, "chrome_port": CHROME_PORT, "focus_filter": FOCUS_FILTER,
              "profile": PROFILE, "vdisplay_bounds": self.vbounds,
              "main_bounds": self.main, "chrome_pid": self.chrome.pid if self.chrome else None,
              "vdisplay_pid": self.vd.pid if self.vd else None, "show": os.path.exists(SHOW_FLAG),
              "updated": time.time()}
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f)
        os.replace(tmp, STATE_FILE)

    def run(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        signal.signal(signal.SIGTERM, lambda *_: setattr(self, "stop", True))
        signal.signal(signal.SIGINT, lambda *_: setattr(self, "stop", True))
        log("supervisor pid %d starting (port %d, profile %s)" % (os.getpid(), PORT, PROFILE))
        ns = notifier_status()
        log("passkey notifier: %s" % ns)
        if not notifier_ok(ns):
            log("NOTIFICATIONS NOT ALLOWED for Hermes Touch ID (%s): passkey requests reveal the window plus a "
                "floating alert instead. Allow them: open '%s'" % (ns, NOTIFIER_SETTINGS_URL))
        self.start_vdisplay()
        self.start_chrome()
        if FOCUS_FILTER:
            self.proxy = CDPProxy(PORT, CHROME_PORT).start(wait=False)
        if FOCUS_GUARD:
            threading.Thread(target=self.focus_loop, daemon=True).start()
            log("focus-guard: on")
        backoff_until = 0
        try:
            while not self.stop:
                if self.vd.poll() is not None:
                    log("vdisplay exited (%s); restarting" % self.vd.returncode)
                    self.start_vdisplay()
                if self.chrome.poll() is not None and time.time() >= backoff_until:
                    log("chrome exited (%s); restarting" % self.chrome.returncode)
                    if self.cdp:
                        self.cdp.close()
                        self.cdp = None
                    self.chrome_fails += 1
                    self.start_chrome()
                    if self.chrome.poll() is None and cdp_version():
                        self.chrome_fails = 0
                    backoff_until = time.time() + min(60, 2 ** min(self.chrome_fails, 6))
                try:
                    if self.connect():
                        self.rehome()
                    self.evict()
                except (CDPError, OSError) as e:
                    log("cdp: %s" % e)
                    if self.cdp:
                        self.cdp.close()
                        self.cdp = None
                self.write_state()
                time.sleep(1)
        finally:
            log("supervisor stopping")
            self.stop_children()


# ---------------------------------------------------------------- CLI

def cmd_status():
    try:
        with open(STATE_FILE) as f:
            st = json.load(f)
    except Exception:
        st = {}
    alive = False
    if st.get("pid"):
        try:
            os.kill(st["pid"], 0)
            alive = True
        except OSError:
            pass
    print("supervisor: %s (pid %s, state age %.0fs)" % ("running" if alive else "NOT running", st.get("pid"),
                                                       time.time() - st.get("updated", 0)))
    print("virtual display: %s   main display: %s" % (st.get("vdisplay_bounds"), st.get("main_bounds")))
    print("mode: %s" % ("SHOW (windows on main display)" if os.path.exists(SHOW_FLAG) else "hidden"))
    ns = notifier_status()
    print("passkey notifier: %s" % ns)
    if not notifier_ok(ns):
        print("  notifications not allowed for Hermes Touch ID: passkey requests reveal the window plus a floating"
              " alert instead.\n  Allow them: open '%s'" % NOTIFIER_SETTINGS_URL)
    print("window eviction (other apps off the virtual display): %s" % evict_status())
    print("focus guard: %s" % ("on (unrequested focus grabs are handed back; see `focus-guard:` log lines)"
                                if FOCUS_GUARD else "off (HERMES_CHROME_AGENT_FOCUS_GUARD=0)"))
    v = cdp_version()
    if FOCUS_FILTER:
        pv = cdp_version(port=PORT)
        print("focus filter: on (clients use http://127.0.0.1:%d -> proxy %s; Chrome on %d; rewrites logged as "
              "`focus-filter:`)" % (PORT, "answering" if pv else "NOT answering", CHROME_PORT))
    else:
        print("focus filter: off (HERMES_CHROME_AGENT_FOCUS_FILTER=0)")
    print("cdp: http://127.0.0.1:%d %s" % (CHROME_PORT, v["Browser"] if v else "NOT answering"))
    if v:
        c = CDP(v["webSocketDebuggerUrl"])
        try:
            for t in c.call("Target.getTargets").get("targetInfos", []):
                if t.get("type") == "page":
                    b = c.call("Browser.getWindowForTarget", {"targetId": t["targetId"]})["bounds"]
                    print("  window %-5s %4s,%-4s %sx%s  %s" % (b.get("windowState"), b.get("left"), b.get("top"),
                                                             b.get("width"), b.get("height"), t.get("url", "")[:90]))
        finally:
            c.close()
    return 0 if alive and v else 1


def evict_status():
    """Trust is per responsible process, so ask from the LaunchAgent's own interpreter via the helper."""
    if not os.path.exists(EVICT):
        return "helper missing (run: hermes-chrome-agent install)"
    plist = os.path.join(HOME, "Library", "LaunchAgents", LABEL + ".plist")
    try:
        with open(plist) as f:
            m = re.search(r"<key>ProgramArguments</key><array><string>([^<]*)</string>", f.read())
        py = m.group(1) if m else "/usr/bin/python3"
    except OSError:
        py = "/usr/bin/python3"
    try:
        r = subprocess.run([py, "-c", "import subprocess,sys;print(subprocess.run([sys.argv[1],'--check'],"
                            "stdout=subprocess.PIPE,universal_newlines=True).stdout.strip())", EVICT],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True, timeout=10)
        res = r.stdout.strip() or "unknown"
    except (subprocess.TimeoutExpired, OSError):
        res = "unknown"
    if res == "untrusted":
        return ("untrusted: %s lacks Accessibility; reinstall with HERMES_CHROME_AGENT_PYTHON=<interpreter that "
                "holds Accessibility>, or grant it in System Settings > Privacy & Security > Accessibility" % py)
    return "%s (interpreter %s)" % (res, py)


def plist_text():
    py = os.environ.get("HERMES_CHROME_AGENT_PYTHON") or "/usr/bin/python3"
    script = os.path.join(TOOLS, "hermes-chrome-agent")
    env = "".join("<key>%s</key><string>%s</string>" % (k, os.environ[k]) for k in
                  ("HERMES_CHROME_AGENT_PORT", "HERMES_CHROME_AGENT_PROFILE", "HERMES_CHROME_AGENT_CHROME",
                   "HERMES_CHROME_AGENT_CHROME_PORT", "HERMES_CHROME_AGENT_FOCUS_FILTER")
                  if os.environ.get(k))
    return """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>%(label)s</string>
  <key>ProgramArguments</key><array><string>%(py)s</string><string>%(script)s</string><string>run</string></array>
  <key>EnvironmentVariables</key><dict><key>HERMES_HOME</key><string>%(home)s</string>%(env)s</dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>%(log)s</string>
  <key>StandardErrorPath</key><string>%(log)s</string>
</dict>
</plist>
""" % {"label": LABEL, "py": py, "script": script, "home": HERMES_HOME, "env": env, "log": LOG}


NOTIFIER_PLIST = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>%s</string>
  <key>CFBundleName</key><string>Hermes Touch ID</string>
  <key>CFBundleDisplayName</key><string>Hermes Touch ID</string>
  <key>CFBundleExecutable</key><string>hermes-touchid-notify</string>
  <key>CFBundleIconFile</key><string>app</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSUIElement</key><true/>
  <key>NSUserNotificationAlertStyle</key><string>alert</string>
</dict></plist>
""" % NOTIFIER_BUNDLE_ID


def build_notifier():
    """Build "Hermes Touch ID.app" (clickable passkey notifications). Signed with a Developer ID when the
    keychain has one (notification permission sticks to the signature), else ad-hoc."""
    macos = os.path.join(NOTIFIER_APP, "Contents", "MacOS")
    res = os.path.join(NOTIFIER_APP, "Contents", "Resources")
    os.makedirs(macos, exist_ok=True)
    os.makedirs(res, exist_ok=True)
    subprocess.check_call(["swiftc", "-O", os.path.join(SRC_DIR, "notifier.swift"), "-o", NOTIFIER_BIN])
    with open(os.path.join(NOTIFIER_APP, "Contents", "Info.plist"), "w") as f:
        f.write(NOTIFIER_PLIST)
    icon = os.path.join(os.path.dirname(os.path.dirname(CHROME)), "Resources", "app.icns")
    if os.path.exists(icon):
        subprocess.call(["cp", icon, os.path.join(res, "app.icns")])
    ident = "-"
    try:
        ids = subprocess.run(["security", "find-identity", "-v", "-p", "codesigning"], capture_output=True,
                             text=True).stdout
        for ln in ids.splitlines():
            if '"Developer ID Application:' in ln:
                ident = ln.split('"')[1]
                break
    except Exception:
        pass
    subprocess.check_call(["codesign", "--force", "--options", "runtime", "-s", ident, NOTIFIER_APP])
    subprocess.call(["/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/"
                     "Support/lsregister", "-f", NOTIFIER_APP])
    return ident


def notifier_status():
    if not os.access(NOTIFIER_BIN, os.X_OK):
        return "not built"
    try:
        return subprocess.run([NOTIFIER_BIN, "--status"], capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception as e:
        return "error %s" % e


def notifier_ok(status):
    return status.split(" ")[0] in ("authorized", "provisional", "ephemeral")


def cmd_install():
    os.makedirs(TOOLS, exist_ok=True)
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    subprocess.check_call(["swiftc", "-O", "-import-objc-header", os.path.join(SRC_DIR, "CGVirtualDisplay.h"),
                           os.path.join(SRC_DIR, "vdisplay.swift"), "-o", VDISPLAY])
    subprocess.check_call(["swiftc", "-O", os.path.join(SRC_DIR, "window-evict.swift"), "-o", EVICT])
    print("notifier signed with %s; notifications: %s" % (build_notifier(), notifier_status()))
    if notifier_status().startswith("notDetermined"):
        # Ask for notification permission now (macOS asks once per app); the helper waits for the answer.
        subprocess.Popen([NOTIFIER_BIN, "--title", "Hermes Touch ID is ready",
                          "--body", "Passkey requests from the hidden Chrome show up here. Click one to see the page.",
                          "--timeout", "600"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        print("click Allow on the 'Hermes Touch ID' notification prompt")
    link = os.path.join(TOOLS, "hermes-chrome-agent")
    me = os.path.realpath(__file__)
    if os.path.realpath(link) != me:
        if os.path.lexists(link):
            os.remove(link)
        os.symlink(me, link)
    plist = os.path.join(HOME, "Library", "LaunchAgents", LABEL + ".plist")
    with open(plist, "w") as f:
        f.write(plist_text())
    uid = os.getuid()
    subprocess.call(["launchctl", "bootout", "gui/%d/%s" % (uid, LABEL)], stderr=subprocess.DEVNULL)
    subprocess.check_call(["launchctl", "bootstrap", "gui/%d" % uid, plist])
    print("installed %s, %s; log %s" % (VDISPLAY, plist, LOG))
    return 0


def cmd_uninstall():
    plist = os.path.join(HOME, "Library", "LaunchAgents", LABEL + ".plist")
    subprocess.call(["launchctl", "bootout", "gui/%d/%s" % (os.getuid(), LABEL)])
    if os.path.exists(plist):
        os.remove(plist)
    print("removed %s (profile %s kept)" % (plist, PROFILE))
    return 0


def show_expired(now=None):
    """The show flag may hold an epoch deadline (`show --minutes N`); empty = until `hide`."""
    try:
        with open(SHOW_FLAG) as f:
            text = f.read().strip()
        return bool(text) and float(text) <= (now or time.time())
    except (OSError, ValueError):
        return False


def cmd_show(minutes=None):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(SHOW_FLAG, "w") as f:
        f.write("%f" % (time.time() + float(minutes) * 60) if minutes else "")
    time.sleep(2)
    print("windows moved to the main display; run `hermes-chrome-agent hide` to send them back"
          + (" (auto-hide in %s min)" % minutes if minutes else ""))
    return 0


def cmd_hide():
    if os.path.exists(SHOW_FLAG):
        os.remove(SHOW_FLAG)
    time.sleep(2)
    print("re-homing resumed")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    table = {"run": lambda: Supervisor().run() or 0, "status": cmd_status,
             "show": lambda: cmd_show(argv[3] if len(argv) > 3 and argv[2] == "--minutes" else None),
             "hide": cmd_hide,
             "install": cmd_install, "uninstall": cmd_uninstall}
    if cmd not in table:
        print(__doc__)
        return 2
    return table[cmd]()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
