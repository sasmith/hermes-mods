From 50820537f0da33a3b98e3fe8d4127050df3521e9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 22 Oct 2026 10:31:16 -0700
Subject: [PATCH] feat(sessions): sessions.interactive_sources allowlist marks
 every other source automated [daveey]

A deny-list (automated_sources) leaks any new bot/eval/scratch source that writes into a human
profile until someone lists it by hand (96 selfheal-replay rows on hub default, 2026-10-22).
When interactive_sources is non-empty, a non-empty source outside it is stamped automated on
every sidebar payload (sidebar slices, unified list, project tree), read from each store's own
home like automated_sources. [] keeps the old behaviour; source-less legacy rows never flagged.
---
 hermes_cli/config_defaults.py                 |  5 ++
 hermes_cli/session_listing.py                 | 56 ++++++++++++++-----
 .../hermes_cli/test_profiles_sidebar_scope.py | 16 ++++++
 tests/hermes_cli/test_session_listing.py      | 38 +++++++++++++
 tui_gateway/methods_projects.py               |  2 +-
 5 files changed, 103 insertions(+), 14 deletions(-)

diff --git a/hermes_cli/config_defaults.py b/hermes_cli/config_defaults.py
index 8baa358e58..6ab16f8610 100644
--- a/hermes_cli/config_defaults.py
+++ b/hermes_cli/config_defaults.py
@@ -2342,6 +2342,11 @@ DEFAULT_CONFIG = {
         # sidebar hides those rows unless "Show automated & test sessions" is on (pinned and
         # blocked / needs-input rows stay). "*" = every session in this profile. [daveey]
         "automated_sources": [],
+        # Allowlist twin of automated_sources: when non-empty, every session whose source is NOT
+        # listed is `automated` too (hidden behind the same toggle), so a new bot / eval / scratch
+        # source writing into a human profile stays out of the sidebar by default. Rows with no
+        # source are never flagged by this list. [] = off (only automated_sources applies). [daveey]
+        "interactive_sources": [],
         # VACUUM after a prune that deleted rows (SQLite never reclaims disk on DELETE). VACUUM
         # blocks writes (~seconds per 100MB), so it runs only at startup, only when ≥1 session was
         # deleted AND freelist/page_count > 25%.
diff --git a/hermes_cli/session_listing.py b/hermes_cli/session_listing.py
