--- a/tests/fixtures/resolution_allowlist.json
+++ b/tests/fixtures/resolution_allowlist.json
@@ -307,6 +307,16 @@
     "symbol": "cmd_gui",
     "kind": "bare_which"
   },
+  {
+    "path": "hermes_cli/main_desktop.py",
+    "symbol": "_prebuilt_desktop_app_mismatch",
