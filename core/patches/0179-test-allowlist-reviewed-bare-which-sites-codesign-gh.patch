+  },
+  {
+    "path": "hermes_cli/main_desktop.py",
+    "symbol": "_prebuilt_signature_error",
+    "kind": "bare_which"
+  },
   {
     "path": "hermes_cli/main_tui_launch.py",
     "symbol": "_apply_tui_python_env",
@@ -658,6 +668,11 @@
