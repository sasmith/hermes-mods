From 2351ebcfefd17a04d15fe18e645b01b01517e99e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 21 Oct 2026 21:21:06 -0700
Subject: [PATCH] fix(desktop): dead-session prune no longer deletes the unsent
 new-chat draft [daveey]
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

stashedDraftScopes() excluded only the legacy '__new__' bucket, so the
per-lifecycle '__new__:<uuid>' key was probed as a session id, 404'd on
every profile and was cleared a few seconds after the user switched to
another chat. The draft-keeping logic from 80d40eb909 then found an empty
bucket and ⌘N rotated to a blank one. Exclude every fresh-draft scope.
---
 apps/desktop/src/store/composer.ts            | 10 ++++++---
 .../src/store/dead-session-prune.test.ts      | 22 ++++++++++++++++++-
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/store/composer.ts b/apps/desktop/src/store/composer.ts
index fb63dbc895..4916fecaea 100644
--- a/apps/desktop/src/store/composer.ts
+++ b/apps/desktop/src/store/composer.ts
@@ -530,12 +530,16 @@ export function takeSessionDraft(scope: string | null | undefined): SessionDraft
 export const clearSessionDraft = (scope: string | null | undefined) => stashSessionDraft(scope, '', [])
 
 /**
- * Stored draft scopes that hold content, excluding the new-chat key. The
+ * Stored draft scopes that hold content, excluding every new-chat key. The
  * dead-session prune sweeps these to discard drafts whose sessions no longer
- * exist on the backend; the new-chat draft is never a session reference.
+ * exist on the backend; a new-chat draft is never a session reference. That
+ * covers the per-lifecycle `__new__:<uuid>` keys too, not just the legacy
+ * `__new__` bucket: the backend 404s on them, so the prune used to delete the
+ * unsent new-chat text a few seconds after the user switched to another
+ * session, and ⌘N came back empty.
  */
 export function stashedDraftScopes(): string[] {
-  return [...draftsBySession.keys()].filter(key => key !== NEW_SESSION_DRAFT_KEY)
+  return [...draftsBySession.keys()].filter(key => !isFreshDraftScope(key))
 }
 
 /**
diff --git a/apps/desktop/src/store/dead-session-prune.test.ts b/apps/desktop/src/store/dead-session-prune.test.ts
index b09a0ac84c..da271f4bda 100644
--- a/apps/desktop/src/store/dead-session-prune.test.ts
+++ b/apps/desktop/src/store/dead-session-prune.test.ts
@@ -14,7 +14,7 @@ vi.mock('@/hermes', async importOriginal => {
   }
 })
 
-import { clearSessionDraft, stashSessionDraft, takeSessionDraft } from '@/store/composer'
+import { clearSessionDraft, rotateFreshDraftKey, stashSessionDraft, takeSessionDraft } from '@/store/composer'
 import { $queuedPromptsBySession, enqueueQueuedPrompt, getQueuedPrompts } from '@/store/composer-queue'
 import { $pinnedSessionIds } from '@/store/layout'
 import { $activeGatewayProfile, $profiles } from '@/store/profile'
@@ -125,6 +125,26 @@ describe('__runDeadSessionPrunePass', () => {
     expect(takeSessionDraft('__new__').text).toBe('brand new')
   })
 
+  it('never discards a per-lifecycle new-chat draft (__new__:<uuid>) — ⌘N must find it again', async () => {
+    // The user typed into a new chat and switched to another session: the
+    // unsent text now lives only in the stash under the rotated fresh key.
+    // The backend 404s on that key (it is not a session id), which must not
+    // read as "dead session".
+    $sessions.set([row('unrelated')])
+    const freshKey = rotateFreshDraftKey()
+    stashSessionDraft(freshKey, 'half-written prompt', [])
+    stashSessionDraft('dead-draft-session', 'stale text', [])
+    getSessionMock.mockRejectedValue(notFound())
+
+    await __runDeadSessionPrunePass()
+
+    expect(takeSessionDraft(freshKey).text).toBe('half-written prompt')
+    expect(getSessionMock).not.toHaveBeenCalledWith(freshKey, expect.anything())
+    // Control: a real dead session's draft is still pruned.
+    expect(takeSessionDraft('dead-draft-session').text).toBe('')
+    clearSessionDraft(freshKey)
+  })
+
   it('drops queued prompts for dead sessions and keeps live ones', async () => {
     $sessions.set([row('unrelated')])
     enqueueQueuedPrompt('dead-queue-session', { text: 'go', attachments: [] })
