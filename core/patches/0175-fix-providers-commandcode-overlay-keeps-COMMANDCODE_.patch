From 4a910d3044d7874cc81ab1f2876f48260403eab9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 21 Oct 2026 23:14:17 -0700
Subject: [PATCH] fix(providers): commandcode overlay keeps COMMANDCODE_API_KEY
 when models.dev lists CMD_API_KEY

---
 hermes_cli/providers.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/hermes_cli/providers.py b/hermes_cli/providers.py
index fc4062c36e..f67d6810c3 100644
--- a/hermes_cli/providers.py
+++ b/hermes_cli/providers.py
@@ -53,6 +53,9 @@ HERMES_OVERLAYS: dict[str, HermesOverlay] = {
                                    base_url_override="https://api.minimax.io/anthropic"),
     "minimax-cn": HermesOverlay(transport="anthropic_messages", base_url_env_var="MINIMAX_CN_BASE_URL"),
     "deepseek": HermesOverlay(base_url_env_var="DEEPSEEK_BASE_URL"),
+    # models.dev lists commandcode with CMD_API_KEY; Hermes' plugin profile reads COMMANDCODE_API_KEY.
+    "commandcode": HermesOverlay(extra_env_vars=("COMMANDCODE_API_KEY",), base_url_override="https://api.commandcode.ai/provider/v1",
+                                 base_url_env_var="COMMANDCODE_BASE_URL"),
     "alibaba": HermesOverlay(base_url_env_var="DASHSCOPE_BASE_URL"),
     "alibaba-coding-plan": HermesOverlay(base_url_env_var="ALIBABA_CODING_PLAN_BASE_URL"),
     "vercel": HermesOverlay(is_aggregator=True),
-- 
